# Copy to .env (never commit .env)
DATACORE_ENVIRONMENT=local
DATACORE_DATABASE_URL=postgresql+psycopg://datacore:datacore@localhost:5432/datacore
DATACORE_LOG_LEVEL=INFO
DATACORE_LOG_JSON=false
# Required for non-local deployments (API milestone)
DATACORE_API_KEY=
POSTGRES_PASSWORD=datacore
# Tests
DATACORE_TEST_DATABASE_URL=postgresql+psycopg://datacore:datacore@localhost:5432/datacore_test
